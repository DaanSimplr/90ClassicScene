---
// Stand-in for a photo that has not been supplied yet. It shows the page's
// own name in outline type. Pass `src` and `alt` once a licensed photo exists.
const { word, wall, hero = false, src, alt = '' } = Astro.props;
---

{
  src ? (
    <div class:list={['frame', hero && 'frame--hero']}>
      <img src={src} alt={alt} style="width:100%;height:100%;object-fit:cover" />
    </div>
  ) : (
    <div class:list={['frame', hero && 'frame--hero']} aria-hidden="true">
      {wall ? (
        <div class="frame__wall">
          {wall.map((row) => (
            <span>{row}</span>
          ))}
        </div>
      ) : (
        <span class="frame__word" data-word={word} style={`--len:${Math.max(word.length, 3)}`}>
          {word}
        </span>
      )}
    </div>
  )
}
