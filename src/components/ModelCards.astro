---
import Card from './Card.astro';
import { firstSentence } from '../lib/copy.js';
import { MODEL_IMAGES } from '../data/images.js';

const { models, filterable = false } = Astro.props;
---

<div class="grid">
  {
    models.map((m) => (
      <Card
        href={m.href}
        eyebrow={m.brand}
        title={m.name}
        text={firstSentence(m.s.f('Opening'))}
        word={m.mark}
        image={MODEL_IMAGES[m.slug]?.card}
        filter={filterable ? { brand: m.brand } : {}}
      />
    ))
  }
</div>
