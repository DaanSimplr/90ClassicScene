---
import { inline } from '../lib/copy.js';

// Every section opens with the orange rule, a numbered eyebrow and a heading.
// The number is generated by a CSS counter, so it is not copy.
const { title, split = false, id } = Astro.props;
---

<section class:list={['section', split && 'section--split']} id={id}>
  <div class="wrap">
    <header class="section__head">
      <span class="rule"></span>
      <p class="eyebrow"></p>
      <h2 set:html={inline(title)} />
    </header>
    <div class="section__body">
      <slot />
    </div>
  </div>
</section>
