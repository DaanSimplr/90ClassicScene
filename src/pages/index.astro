---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import ModelCards from '../components/ModelCards.astro';
import Rows from '../components/Rows.astro';
import Signup from '../components/Signup.astro';
import { sec, paragraphs, isActions, actions, inline, leadItems, LINKS } from '../lib/copy.js';
import { SITE_NAME, modelBy } from '../lib/site.js';
import { PAGE_IMAGES } from '../data/images.js';

const s = sec('Home');
const opening = paragraphs(s.f('Opening'));
const lead = opening
  .filter((p) => !isActions(p))
  .map((p) => `<p>${inline(p)}</p>`)
  .join('');
const heroActions = opening.find(isActions);

const [what, start, other] = s.h2s;
const startParas = paragraphs(start.body);
const cars = startParas[0].split(' · ').map((name) => modelBy('name', name));
const startActions = startParas.find(isActions);
---

<Base title={s.f('Title')} description={s.f('Description')}>
  <Hero eyebrow={SITE_NAME} title={s.f('H1')} lead={lead} display image={PAGE_IMAGES.home}>
    <Fragment set:html={actions(heroActions)} />
  </Hero>

  <Section title={what.label}>
    <ul class="points">
      {
        leadItems(what.body).map((item) => (
          <li>
            <h3>{item.lead}</h3>
            <p>{item.text}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section title={start.label}>
    <div class="stack">
      <ModelCards models={cars} />
      <Fragment set:html={actions(startActions, { primary: false })} />
    </div>
  </Section>

  <Section title={other.label}>
    <Rows
      items={leadItems(other.body).map((item) => ({
        href: LINKS[item.lead],
        title: item.lead,
        text: item.text,
      }))}
    />
  </Section>

  <Signup line={s.f('Signup box line')} />
</Base>
