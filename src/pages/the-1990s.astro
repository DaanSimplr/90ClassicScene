---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Signup from '../components/Signup.astro';
import { sec, blocks } from '../lib/copy.js';
import { SITE_NAME, MODELS } from '../lib/site.js';

const s = sec('The 1990s');
const parts = s.h2s.filter((h) => h.label !== 'Timeline');
const timeline = s.h2('Timeline');
// The copy fixes the era's two ends in its opening line; the dates in between
// are still to be filled from sources, so the cars are listed without years.
const [from, to] = s.f('Opening').match(/\b(19|20)\d\d\b/g);
---

<Base title={s.f('Title')} description={s.f('Description')} active="The 1990s">
  <Hero eyebrow={SITE_NAME} title={s.f('H1')} lead={blocks(s.f('Opening'))} word="1990s" />

  {
    parts.map((part) => (
      <Section title={part.label} split>
        <div class="prose" set:html={blocks(part.body)} />
      </Section>
    ))
  }

  <Section title={timeline.label} split>
    <div class="timeline">
      <p class="timeline__year">{from}</p>
      <div class="timeline__events">
        <ul>
          {
            MODELS.map((m) => (
              <li>
                <a href={m.href}>{m.name}</a>
              </li>
            ))
          }
        </ul>
      </div>
      <p class="timeline__year">{to}</p>
    </div>
  </Section>

  <Signup line={s.f('Signup box line')} />
</Base>
